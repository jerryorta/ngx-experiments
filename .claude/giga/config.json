{
  "ux": {
    "devServerSkill": "giga-workflow:dev-server"
  },
  "angular": {
    "prefix": "nge",
    "storybook": {
      "app": "apps/storybook-app",
      "reviewContainerImport": "@nge/storybook",
      "storyExamples": [
        {
          "name": "Input",
          "path": "libs/shared/ui-design-library/src/lib/dlc-input/stories/"
        },
        {
          "name": "Button",
          "path": "libs/shared/ui-design-library/src/lib/dlc-button/stories/"
        },
        {
          "name": "Select",
          "path": "libs/shared/ui-design-library/src/lib/dlc-select/stories/"
        },
        {
          "name": "Address Autocomplete",
          "path": "libs/shared/ui-design-library/src/lib/dlc-address-autocomplete/stories/"
        },
        {
          "name": "Charts",
          "path": "libs/shared/charts/src/lib/nge-chart/stories/"
        },
        {
          "name": "Calendar",
          "path": "libs/shared/calendar/src/lib/nge-calendar/stories/generic/"
        }
      ]
    },
    "componentState": {
      "references": [
        {
          "path": "libs/shared/calendar/src/lib/nge-calendar/store/",
          "note": "Multi-component system, multi-file root composing features/: a 31-line nge-calendar-store.ts, nge-calendar-store.state.ts and nge-calendar-store.types.ts, one features/with-calendar-<concern>.ts per concern (drag, filter, navigation, popover, selection, viewmodel). Provided on nge-calendar.component.ts; its views inject it."
        },
        {
          "path": "libs/ledger/ui/src/lib/overview/overview.store.ts",
          "note": "Single-file page store: withState, withProps, withComputed and withMethods in one file, provided on its screen component. As canonical as the multi-file root while its concerns stay few and cohesive. A page store over LedgerFacade: the facade injected in withComputed, reads projected there, writes delegated from withMethods."
        },
        {
          "path": "libs/ledger/ui/src/lib/transactions/transactions.store.ts",
          "note": "Single-file page store for search, filters, date range, sort, selected row and dialog state. A page store over LedgerFacade: the facade injected in withComputed, reads projected there, writes delegated from withMethods."
        },
        {
          "path": "libs/ledger/ui/src/lib/budgets/budgets.store.ts",
          "note": "Single-file page store with withProps-injected dependencies. A page store over LedgerFacade: the facade injected in withComputed, reads projected there, writes delegated from withMethods."
        }
      ],
      "standards": [
        "docs/ai/CONSTRAINTS.md § Component-Scoped State",
        "docs/ai-instructions/reference/multi-component-signal-store.instructions.md",
        "docs/ai-instructions/standards/signal-store.md"
      ]
    },
    "ngrxDocs": "~/Dev/open-source/platform",
    "globalStoreSkill": "ngrx-global-store",
    "globalStore": {
      "layout": "flat",
      "standards": [
        "docs/reference/ngrx/facades-and-selectors.md",
        "docs/ai/CONSTRAINTS.md § NgRx Facades & Selectors"
      ],
      "stores": [
        {
          "name": "ledger",
          "lib": "libs/ledger/store",
          "alias": "@nge/ledger-store",
          "registration": "libs/ledger/store/src/lib/provide-ledger-store.ts",
          "registrationNote": "provideLedgerStore() returns makeEnvironmentProviders([provideState(ledgerFeature), provideEffects(LedgerEffects)]); apps/ledger/app/src/app/app.config.ts calls it after the root provideStore(). A second slice gets its own provide-<slice>-store.ts called there too.",
          "references": [
            {
              "path": "libs/ledger/store/src/lib/ledger.feature.ts",
              "note": "createFeature with its reducer and extraSelectors in one file, one createEntityAdapter per collection; derived selectors (cashflow, net worth, spending by category) over pure @nge/ledger-utils functions."
            },
            {
              "path": "libs/ledger/store/src/lib/ledger.effects.ts",
              "note": "An @Injectable() effects class; the load effect writes switchMap + catchError out, and a latency InjectionToken lets specs resolve on the next macrotask (zoneless: no fakeAsync / tick)."
            },
            {
              "path": "libs/ledger/store/src/lib/ledger.facade.ts",
              "note": "The only surface components inject."
            },
            {
              "path": "libs/ledger/store/src/lib/provide-ledger-store.ts",
              "note": "Registration through makeEnvironmentProviders, called once at the app root."
            }
          ],
          "standards": [
            "libs/ledger/store/AGENTS.md"
          ]
        }
      ]
    },
    "newDomain": {
      "scope": "@nge",
      "appsRoot": "apps",
      "libsRoot": "libs",
      "app": {
        "generator": "@nx/angular:application",
        "flags": [
          "--routing=true",
          "--e2eTestRunner=none"
        ]
      },
      "libs": [
        {
          "type": "models",
          "generator": "@nx/js:library"
        },
        {
          "type": "store",
          "generator": "@nx/angular:library"
        },
        {
          "type": "themes",
          "generator": "@nx/angular:library",
          "flags": [
            "--unitTestRunner=none"
          ],
          "tests": false
        },
        {
          "type": "ui",
          "generator": "@nx/angular:library"
        },
        {
          "type": "design-library",
          "generator": "@nx/angular:library"
        },
        {
          "type": "utils",
          "generator": "@nx/angular:library"
        },
        {
          "type": "mocks",
          "generator": "@nx/js:library"
        }
      ],
      "tags": [
        "scope:<domain>",
        "type:<type>"
      ],
      "guide": "docs/reference/domain-library-set.md",
      "referenceDomain": "ledger",
      "themeExample": "libs/ledger/themes/src/lib/styles/",
      "scripts": {
        "serve": {
          "name": "s.app.<domain>",
          "command": "npx nx run <domain>-app:serve:local-dev --skip-nx-cache --port <port>"
        },
        "build": {
          "name": "b.app.<domain>",
          "command": "npx nx run <domain>-app:build --configuration=production --skip-nx-cache"
        }
      },
      "moduleBoundaries": "eslint.config.mjs",
      "agentsMd": {
        "typeStandards": "docs/ai-instructions/standards/lib-types",
        "constraints": "docs/ai/CONSTRAINTS.md",
        "deltaExample": "libs/ledger/store/AGENTS.md"
      }
    },
    "theming": {
      "tokenFile": "libs/<domain>/themes/src/lib/styles/_<prefix>-tokens.scss",
      "tokenDocs": "libs/<domain>/themes/AGENTS.md",
      "standards": [
        "docs/ai/CONSTRAINTS.md § Angular Material",
        "docs/ai-instructions/standards/styling.md",
        "docs/reference/styling-conventions.md"
      ],
      "bannedTokens": [
        "--mat-sys-"
      ]
    },
    "accessibility": {
      "standards": [
        {
          "doc": "docs/ai-instructions/reference/accessibility-selectors.instructions.md"
        }
      ]
    },
    "promote": {
      "sharedLibrary": {
        "path": "libs/shared/ui-design-library",
        "prefix": "dlc",
        "alias": "@nge/ui-design-library",
        "storyTitle": "UI Design Library"
      },
      "domains": [
        {
          "domain": "ledger",
          "prefix": "ldg",
          "storyTitle": "Ledger Design Library"
        }
      ],
      "domainLibraryPath": "libs/<domain>/design-library",
      "libraryDoc": "docs/reference/domain-library-set.md",
      "banned": [
        "@angular/material",
        "<mat-",
        "--mat-sys-"
      ],
      "verify": "npx nx affected -t build lint test"
    }
  },
  "workflow": {
    "plans": {
      "repo": "~/Dev/gigasoftware-plans",
      "script": "~/Dev/gigasoftware-plans/scripts/jira_to_md.py",
      "guide": "~/Dev/gigasoftware-plans/AGENTS.md",
      "autoPush": true
    },
    "jira": {
      "site": "gigasoftware.atlassian.net",
      "cloudId": "0c34459b-6029-4c84-962e-da03ad010fd0",
      "credentialsFile": "~/Dev/gigasoftware_secrets/jira.json",
      "mcpPrefix": "mcp__claude_ai_Atlassian__",
      "createStatus": "To Do"
    },
    "git": {
      "mainBranch": "main",
      "branchPrefix": "feat/",
      "mergeMethod": "squash",
      "autoMerge": false,
      "hasCI": true
    },
    "commit": {
      "format": "<type>(<scope>): <KEY> <subject>",
      "hooks": false,
      "refactorCommitFirst": true
    },
    "checks": {
      "gate": "npx nx run-many -t build lint test -p <projects> --output-style=stream",
      "affected": "npx nx affected -t build lint test",
      "single": "npx nx run <project>:<target>"
    },
    "docs": {
      "constraints": "docs/ai/CONSTRAINTS.md",
      "antiPatterns": "docs/ai/ANTI-PATTERNS.json",
      "commands": "docs/reference/commands.md",
      "testingStrategy": "docs/reference/testing-strategy.md",
      "agentsMd": [
        "AGENTS.md",
        "apps/<app>/app/AGENTS.md",
        "libs/<domain>/ui/AGENTS.md",
        "libs/<domain>/store/AGENTS.md",
        "libs/<domain>/design-library/AGENTS.md",
        "libs/<domain>/themes/AGENTS.md",
        "libs/shared/ui-design-library/AGENTS.md"
      ]
    },
    "devServers": [
      {
        "app": "ledger",
        "command": "npm run s.app.ledger",
        "port": 4203,
        "logFile": "/tmp/ledger-dev-server.log",
        "kind": "app"
      },
      {
        "app": "storybook",
        "command": "npm run storybook",
        "port": 4400,
        "logFile": "/tmp/ngx-storybook.log",
        "kind": "storybook"
      }
    ],
    "storybook": {
      "ports": [
        4400
      ]
    },
    "planning": {
      "dependencySignals": [
        "design-token set",
        "theme persona",
        "chart core/* primitive",
        "with-* signalStore feature",
        "public barrel export",
        "nx.json",
        "eslint.config.mjs",
        "jest.config.cts",
        ".storybook/",
        "generator",
        "migration"
      ],
      "frontendGlobs": [
        "libs/<domain>/store",
        "libs/<domain>/ui"
      ],
      "designLibrary": {
        "prefix": "dlc-",
        "path": "libs/shared/ui-design-library"
      }
    },
    "loop": {
      "ledgerDir": "~/.claude/epic-loop",
      "neverUnattended": [
        "anything touching secrets, credentials, or a deploy"
      ],
      "decisionSkills": {
        "chart": "dataviz",
        "accessibility": "verify-accessibility"
      },
      "precedentClones": "~/Dev/open-source",
      "precedentPaths": {
        "domain": [
          "libs/<domain>/*",
          "apps/<domain>/*"
        ],
        "global": [
          "docs/reference/*",
          "docs/ai-instructions/*",
          "libs/shared/*"
        ]
      }
    },
    "browser": {
      "renderingFiles": "\\.component\\.ts$|\\.html$|\\.scss$",
      "runProfileLabel": "DEVELOPER",
      "chromeBinary": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    },
    "notify": "~/.claude/bin/claude-notify",
    "memoryDir": "~/Dev/gigasoftware-memory/memory",
    "boardTemplate": ".claude/giga/board-template.json"
  },
  "standards": {
    "constraintsFile": "docs/ai/CONSTRAINTS.md",
    "antiPatternsFile": "docs/ai/ANTI-PATTERNS.json",
    "fragmentsDir": "docs/ai-instructions/standards",
    "libTypesDir": "docs/ai-instructions/standards/lib-types",
    "guidesDir": "docs/ai-instructions",
    "sourceFilePattern": "(apps|libs)/[A-Za-z0-9_./-]+\\.(ts|html|scss)",
    "budgetBytes": 9800,
    "artifacts": [
      {
        "match": [
          "*.spec.ts"
        ],
        "artifact": "test",
        "sections": [
          "Testing",
          "Zoneless Change Detection"
        ],
        "antiPatterns": [
          "jasmine-import"
        ],
        "guide": "docs/reference/testing-strategy.md"
      },
      {
        "match": [
          "*.component.html"
        ],
        "artifact": "template",
        "sections": [
          "Angular Conventions"
        ],
        "antiPatterns": [
          "legacy-ngIf",
          "legacy-ngFor",
          "legacy-ngSwitch",
          "mat-component-selector"
        ]
      },
      {
        "match": [
          "*libs/shared/ui-design-library/*.component.ts"
        ],
        "artifact": "uidl",
        "sections": [
          "UI Design Library",
          "Component File Structure"
        ],
        "antiPatterns": [
          "uidl-host-selector",
          "uidl-missing-host-class",
          "inline-template",
          "inline-styles"
        ],
        "guide": "libs/shared/ui-design-library/COMPONENT-ARCHITECTURE-BEST-PRACTICES.md"
      },
      {
        "match": [
          "*/src/app/*.component.ts"
        ],
        "artifact": "component",
        "sections": [
          "Component File Structure",
          "Angular Conventions",
          "Component-Scoped State",
          "Application Components"
        ],
        "antiPatterns": [
          "constructor-injection",
          "input-decorator",
          "output-decorator",
          "inline-template",
          "inline-styles",
          "angular-material-import"
        ]
      },
      {
        "match": [
          "*.component.ts"
        ],
        "artifact": "component",
        "sections": [
          "Component File Structure",
          "Angular Conventions",
          "Component-Scoped State"
        ],
        "antiPatterns": [
          "constructor-injection",
          "input-decorator",
          "output-decorator",
          "inline-template",
          "inline-styles",
          "angular-material-import"
        ]
      },
      {
        "match": [
          "*.service.ts"
        ],
        "artifact": "service",
        "sections": [
          "Angular Conventions"
        ],
        "antiPatterns": [
          "constructor-injection",
          "service-lifecycle-hook"
        ]
      },
      {
        "match": [
          "*.selectors.ts",
          "*.reducer.ts",
          "*.effects.ts",
          "*.actions.ts",
          "*.facade.ts"
        ],
        "artifact": "ngrx",
        "sections": [
          "NgRx Facades & Selectors"
        ],
        "antiPatterns": [
          "constructor-injection"
        ],
        "guide": "docs/reference/ngrx/facades-and-selectors.md"
      },
      {
        "match": [
          "*.store.ts",
          "*/store/*"
        ],
        "artifact": "store",
        "sections": [
          "Component-Scoped State",
          "NgRx Facades & Selectors"
        ],
        "antiPatterns": [
          "constructor-injection"
        ]
      },
      {
        "match": [
          "*.scss"
        ],
        "artifact": "styling",
        "sections": [
          "Styling",
          "Angular Material — Legacy Only (NOT for New Development)"
        ],
        "antiPatterns": [
          "mat-sys-token"
        ],
        "guide": "docs/reference/styling-conventions.md"
      },
      {
        "match": [
          "*.ts"
        ],
        "artifact": "angular",
        "sections": [
          "Angular Conventions"
        ],
        "antiPatterns": [
          "constructor-injection",
          "any-type"
        ]
      }
    ]
  }
}
